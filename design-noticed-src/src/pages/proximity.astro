---
import Base from '../layouts/Base.astro';
import PrincipleHeader from '../components/PrincipleHeader.astro';
import Step from '../components/Step.astro';
import Named from '../components/Named.astro';
import Make from '../components/Make.astro';
import NoticeBoard from '../components/proximity/NoticeBoard.astro';
import GroupingGame from '../components/proximity/GroupingGame.astro';
import Spotted from '../components/proximity/Spotted.astro';
import { pages } from '../links';

const ideas = [
  { kind: 'close', say: 'Close together', mean: 'These belong to each other.' },
  { kind: 'far', say: 'Far apart', mean: 'These are strangers.' },
  { kind: 'even', say: 'Evenly spaced', mean: 'The space is saying nothing at all.' },
];
---

<Base
  title="Proximity"
  description="Distance communicates relationship. Notes, a drag-and-group experiment and real-world examples of the proximity principle."
>
  <PrincipleHeader name="Proximity" />

  <Step n="01" label="See">
    <NoticeBoard />
  </Step>

  <Step n="02" label="Name">
    <Named
      word="Proximity"
      size={17.4}
      gloss="prox·im·i·ty, n. nearness."
      idea="Distance communicates relationship."
    />
  </Step>

  <Step n="03" label="Understand">
    <div class="ideas">
      {
        ideas.map((idea) => (
          <div class="idea">
            <div class={`idea__fig dots dots--${idea.kind}`} aria-hidden="true">
              <i />
              <i />
              <i />
              <i />
            </div>
            <p class="label">{idea.say}</p>
            <p class="idea__mean">{idea.mean}</p>
          </div>
        ))
      }
    </div>
    <div class="prose understand">
      <p>
        When two things sit near each other, I assume they’re related. When they sit far apart, I
        assume they aren’t. I do this before I read anything, and so does everybody else.
      </p>
      <p>
        That means the space between things is never empty. It’s information. If a heading sits
        closer to the paragraph above it than to its own, I’ve told the reader something false
        without typing a word.
      </p>
      <p>
        So the job is simple to say: put related things close, push unrelated things apart, and make
        the two distances obviously different.
      </p>
    </div>
  </Step>

  <Step n="04" label="Play">
    <GroupingGame />
  </Step>

  <Step n="05" label="Notice">
    <Spotted />
  </Step>

  <Step n="06" label="Make">
    <Make
      sighting="Find something where related information is visually too far apart. Photograph it before you fix it in your head."
      exercise="Open an old slide and improve it using spacing only. No new fonts. No new colours."
      rule="Distance communicates relationship."
      next={pages[1]}
    />
  </Step>
</Base>

<style>
  .dots i {
    top: 50%;
    left: var(--at);
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border-radius: 50%;
  }

  .dots--close i:nth-child(1) { --at: 41%; }
  .dots--close i:nth-child(2) { --at: 47%; }
  .dots--close i:nth-child(3) { --at: 53%; }
  .dots--close i:nth-child(4) { --at: 59%; }

  .dots--far i:nth-child(1) { --at: 12%; }
  .dots--far i:nth-child(2) { --at: 18%; }
  .dots--far i:nth-child(3) { --at: 82%; }
  .dots--far i:nth-child(4) { --at: 88%; }

  .dots--even i:nth-child(1) { --at: 20%; }
  .dots--even i:nth-child(2) { --at: 40%; }
  .dots--even i:nth-child(3) { --at: 60%; }
  .dots--even i:nth-child(4) { --at: 80%; }
</style>
