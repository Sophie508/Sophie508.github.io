---
const drinks = [
  ['Kopi O', '1.40'],
  ['Kopi C', '1.60'],
  ['Kopi peng', '1.90'],
  ['Teh tarik', '1.80'],
  ['Milo dinosaur', '2.80'],
];
---

<svg class="sketch" viewBox="0 0 400 500" role="img" aria-label="Sketch of a coffee stall menu board with one very large heading and quiet rows of drinks and prices">
  <rect x="34" y="46" width="332" height="396" fill="#1d211d"></rect>
  <rect x="34" y="46" width="332" height="396" fill="none" stroke="#14120f" stroke-width="6"></rect>
  <text class="s-display" x="58" y="172" font-size="118" fill="#f4f1ea">KOPI</text>
  <line x1="60" y1="200" x2="340" y2="200" stroke="#f4f1ea" stroke-width="1.5"></line>
  {
    drinks.map(([name, price], i) => (
      <g fill="#f4f1ea" opacity="0.78" font-size="19">
        <text x="60" y={244 + i * 38}>{name}</text>
        <text x="340" y={244 + i * 38} text-anchor="end">{price}</text>
      </g>
    ))
  }
  <text class="s-mono" x="60" y="424" font-size="10" fill="#f4f1ea" opacity="0.6">Iced + 0.50</text>
  <path class="s-pen" d="M204 62c-84-6-162 14-164 58-2 42 70 70 160 70 96 0 168-24 168-66 0-40-70-66-170-60"></path>
  <text class="s-hand" x="262" y="34" font-size="30" transform="rotate(-4 262 34)">loud</text>
  <path class="s-pen" d="M236 484c-22 2-40-8-46-30m-8 12 8-14 12 10"></path>
  <text class="s-hand" x="246" y="492" font-size="30" transform="rotate(-3 246 492)">quiet</text>
</svg>
