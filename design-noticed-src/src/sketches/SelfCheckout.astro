---
const items = [92, 118, 74, 104];
---

<svg class="sketch" viewBox="0 0 400 500" role="img" aria-label="Sketch of a self checkout kiosk where the payment instruction sits far from the card reader it refers to">
  <rect x="176" y="300" width="48" height="150" fill="#14120f" opacity="0.85"></rect>
  <rect x="150" y="450" width="100" height="12" fill="#14120f"></rect>
  <rect x="40" y="44" width="320" height="270" rx="10" fill="#fdfcf9" stroke="#14120f" stroke-width="3"></rect>
  <text class="s-mono" x="62" y="78" font-size="9.5" fill="#14120f">Tap card on reader</text>
  {
    items.map((w, i) => (
      <g>
        <rect x="62" y={108 + i * 30} width={w} height="7" fill="#14120f" opacity="0.28" />
        <rect x="196" y={108 + i * 30} width="26" height="7" fill="#14120f" opacity="0.28" />
      </g>
    ))
  }
  <line x1="62" y1="234" x2="222" y2="234" stroke="#14120f" stroke-width="1"></line>
  <text class="s-mono" x="62" y="262" font-size="9.5" fill="#5d584f">Total</text>
  <text class="s-display" x="62" y="296" font-size="30">$18.40</text>
  <rect x="250" y="252" width="90" height="44" fill="#14120f"></rect>
  <text class="s-mono" x="295" y="279" font-size="11" fill="#fdfcf9" text-anchor="middle">Pay</text>
  <rect x="286" y="352" width="84" height="104" rx="8" fill="#fdfcf9" stroke="#14120f" stroke-width="3"></rect>
  <path d="M316 418a20 20 0 0 1 0-28m12 36a32 32 0 0 0 0-44m12 52a44 44 0 0 0 0-60" fill="none" stroke="#14120f" stroke-width="3" stroke-linecap="round" transform="translate(-10 0)"></path>
  <path class="s-pen" d="M150 92c40 40 96 150 132 262m-142-256 10-6 2 12m118 238 12 12 6-16"></path>
  <text class="s-hand" x="34" y="368" font-size="29" transform="rotate(-5 34 368)">the words</text>
  <text class="s-hand" x="38" y="396" font-size="29" transform="rotate(-5 38 396)">are up here,</text>
  <text class="s-hand" x="42" y="424" font-size="29" transform="rotate(-5 42 424)">the reader</text>
  <text class="s-hand" x="46" y="452" font-size="29" transform="rotate(-5 46 452)">is there</text>
</svg>
