---
import Gallery from '../Gallery.astro';

const menu = [
  ['Noodles', ['Laksa', 'Mee goreng']],
  ['Rice', ['Chicken rice', 'Nasi lemak']],
  ['Drinks', ['Lime juice']],
] as const;

const signs = [
  ['Library', 'M14 0H-14m9-9-9 9 9 9'],
  ['Canteen', 'M-14 0h28m-9-9 9 9-9 9'],
  ['Lecture hall 3', 'M0 14V-14m-9 9 9-9 9 9'],
  ['Toilets', 'M-14 0h28m-9-9 9 9-9 9'],
] as const;
---

<Gallery off="As I found it" on="Moved closer" aside="nothing is added or removed. things only move.">
  <li class="spot__item">
    <div class="art">
      <div class="menu">
        {
          menu.map(([heading, dishes]) => (
            <>
              <p class="menu__h">{heading}</p>
              {dishes.map((dish) => (
                <p class="menu__d">{dish}</p>
              ))}
            </>
          ))
        }
      </div>
    </div>
    <p class="label">Menus</p>
    <p class="spot__note">
      The heading floats halfway, so “Rice” could just as easily belong to the noodles.
    </p>
  </li>

  <li class="spot__item">
    <div class="art">
      <div class="form">
        <p class="form__l">Name</p>
        <span class="form__f"></span>
        <p class="form__l">Email</p>
        <span class="form__f"></span>
        <p class="form__l">Message</p>
        <span class="form__f form__f--tall"></span>
      </div>
    </div>
    <p class="label">Forms</p>
    <p class="spot__note">Each label sits closer to the box above it than to its own box.</p>
  </li>

  <li class="spot__item">
    <div class="art art--desk">
      <div class="card">
        <span class="card__name">Mei Tan</span>
        <span class="card__role">Ceramics, small batches</span>
        <span class="card__a">mei@kilnlane.example</span>
        <span class="card__b">kilnlane.example</span>
        <span class="card__c">12 Kiln Lane</span>
        <span class="card__d">By appointment</span>
      </div>
    </div>
    <p class="label">Business cards</p>
    <p class="spot__note">
      Six places to look. My eye bounces from corner to corner and never settles.
    </p>
  </li>

  <li class="spot__item">
    <div class="art">
      <div class="web">
        <span class="web__img web__img--a"></span>
        <p class="web__cap">Morning at the market</p>
        <span class="web__img web__img--b"></span>
        <p class="web__cap">The last tram home</p>
      </div>
    </div>
    <p class="label">Websites</p>
    <p class="spot__note">
      Which picture is the caption talking about? The gap is supposed to answer that.
    </p>
  </li>

  <li class="spot__item">
    <div class="art art--dark">
      <div class="sign">
        {
          signs.map(([place, arrow]) => (
            <p>
              <span>{place}</span>
              <svg viewBox="-18 -18 36 36" aria-hidden="true">
                <path d={arrow} />
              </svg>
            </p>
          ))
        }
      </div>
    </div>
    <p class="label">Public signs</p>
    <p class="spot__note">
      The arrow is so far from its word that I could pair it with the wrong row.
    </p>
  </li>
</Gallery>

<style>
  /* Menu: the heading drifts between two groups, then joins its own */
  .menu {
    width: min(100%, 210px);
    height: 282px;
    padding: 12px 24px;
    background: var(--sheet);
    border: 1px solid var(--ink);
  }

  .menu p {
    margin-top: 12px;
  }

  .menu__h {
    font-family: var(--mono);
    font-size: 0.78em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global([data-fixed]) .menu__h {
    margin-top: 30px;
  }

  :global([data-fixed]) .menu__h:first-child {
    margin-top: 12px;
  }

  :global([data-fixed]) .menu__d {
    margin-top: 3px;
  }

  /* Form: each label leaves the box above and joins the one below */
  .form {
    width: min(100%, 220px);
  }

  .form__l {
    margin: 5px 0 17px;
    font-weight: 600;
  }

  .form__f {
    display: block;
    height: 30px;
    background: var(--sheet);
    border: 1px solid var(--ink);
  }

  .form__f--tall {
    height: 58px;
  }

  :global([data-fixed]) .form__l {
    margin: 17px 0 5px;
  }

  /* Business card: six scattered corners become two groups */
  .card {
    position: relative;
    width: min(100%, 300px);
    aspect-ratio: 1.7;
    background: var(--sheet);
    border: 1px solid var(--ink);
    font-size: 0.82em;
  }

  .card span {
    position: absolute;
    white-space: nowrap;
  }

  .card__name {
    left: 50%;
    top: 40%;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.9em;
    letter-spacing: -0.02em;
    transform: translate(-50%, -50%);
  }

  .card__role {
    left: 50%;
    top: 56%;
    transform: translate(-50%, 0);
  }

  .card__a {
    left: 6%;
    top: 7%;
  }

  .card__b {
    left: 94%;
    top: 7%;
    transform: translate(-100%, 0);
  }

  .card__c {
    left: 6%;
    top: 84%;
  }

  .card__d {
    left: 94%;
    top: 84%;
    transform: translate(-100%, 0);
  }

  :global([data-fixed]) .card span {
    left: 9%;
    transform: translate(0, 0);
  }

  :global([data-fixed]) .card__name {
    top: 11%;
  }

  :global([data-fixed]) .card__role {
    top: 30%;
  }

  :global([data-fixed]) .card__a {
    top: 57%;
  }

  :global([data-fixed]) .card__b {
    top: 67%;
  }

  :global([data-fixed]) .card__c {
    top: 77%;
  }

  :global([data-fixed]) .card__d {
    top: 87%;
  }

  /* Website: a caption stranded between two pictures picks one */
  .web {
    width: min(100%, 200px);
  }

  .web__img {
    display: block;
    height: 86px;
  }

  .web__img--a {
    background: #9fb0a3;
  }

  .web__img--b {
    background: #d3a58c;
  }

  .web__cap {
    margin: 17px 0;
    font-weight: 600;
  }

  :global([data-fixed]) .web__cap {
    margin: 6px 0 28px;
  }

  /* Sign: each arrow travels across the board to stand beside its word */
  .sign {
    width: min(100%, 250px);
    font-size: 1.35em;
    font-weight: 600;
  }

  .sign p {
    display: flex;
    align-items: center;
    margin-top: 4px;
  }

  .sign span {
    flex-grow: 1;
  }

  .sign svg {
    width: 26px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-fixed]) .sign p {
    margin-top: 26px;
  }

  :global([data-fixed]) .sign p:first-child {
    margin-top: 4px;
  }

  :global([data-fixed]) .sign span {
    flex-grow: 0;
    margin-right: 14px;
  }
</style>
