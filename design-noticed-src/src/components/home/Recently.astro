---
import { getCollection } from 'astro:content';
import SightingCard from '../SightingCard.astro';
import { href, sightingsPage } from '../../links';

const sightings = (await getCollection('sightings'))
  .sort((a, b) => b.data.number - a.data.number)
  .slice(0, 4);
---

<section class="recent wrap" id="recently-noticed">
  <header class="recent__head">
    <h2 class="recent__title display">Recently<br />noticed</h2>
    <a class="recent__all label" href={href(sightingsPage.path)}>All Design Sightings →</a>
  </header>

  <ol class="recent__list">
    {
      sightings.map((sighting) => (
        <li>
          <SightingCard sighting={sighting} />
        </li>
      ))
    }
  </ol>
</section>

<style>
  .recent {
    margin-top: var(--section-space);
  }

  .recent__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    padding-bottom: 18px;
    border-bottom: 1.5px solid var(--ink);
  }

  .recent__title {
    font-size: clamp(2.5rem, 5.6vw, 5.2rem);
  }

  .recent__all {
    padding-bottom: 3px;
    border-bottom: 1.5px solid var(--ink);
  }

  .recent__all:hover {
    color: var(--pen);
    border-bottom-color: var(--pen);
  }

  .recent__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--column-gap);
    margin-top: clamp(28px, 4vw, 52px);
  }

  .recent__list li:nth-child(even) {
    margin-top: clamp(40px, 6vw, 96px);
  }

  @media (max-width: 900px) {
    .recent__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
</style>
