---
const readings = [
  { key: 'size', name: 'Size' },
  { key: 'weight', name: 'Weight' },
  { key: 'value', name: 'Colour value' },
  { key: 'space', name: 'Space' },
  { key: 'image', name: 'Image scale' },
  { key: 'levels', name: 'Hierarchy' },
];
---

<div class="machine" data-machine style="--c:0.09">
  <div class="machine__head">
    <h2 class="headline">The contrast machine.</h2>
    <p class="machine__rule">
      One slider, six things changing at once. Drag it slowly from the left and watch for the
      moment the poster stops looking like a mistake and starts looking like a decision.
    </p>
  </div>

  <div class="machine__stage">
    <div class="bill">
      <span class="bill__moon"></span>
      <div class="bill__in">
        <p class="bill__title">Night<br />Market</p>
        <p class="bill__date">Fri 21 Nov</p>
        <p class="bill__line">6 pm till late</p>
        <p class="bill__line">Carpark B, Block 12</p>
        <p class="bill__line">Free entry</p>
      </div>
    </div>

    <div class="machine__panel">
      <p class="label machine__zone-label">Right now this is</p>
      <p class="machine__zone" data-zone>Just different</p>
      <p class="machine__verdict" data-verdict role="status"></p>

      <dl class="machine__readings">
        {
          readings.map((reading) => (
            <div>
              <dt class="label">{reading.name}</dt>
              <dd data-reading={reading.key} />
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="machine__slider">
    <label class="label" for="contrast-amount">Weak</label>
    <div class="machine__track">
      <input id="contrast-amount" type="range" min="0" max="100" value="30" data-amount aria-label="Amount of contrast" />
      <span class="machine__mark" style="--at:6%"></span>
      <span class="machine__mark" style="--at:55%"></span>
    </div>
    <span class="label">Strong</span>
  </div>
</div>

<script>
  const ZONES = [
    {
      until: 6,
      name: 'The same',
      verdict: 'Everything is equal. It’s calm, but nothing leads and I have to read it all.',
      levels: '1 level',
    },
    {
      until: 55,
      name: 'Just different',
      verdict: 'This is the trap. Things differ, but not enough to mean anything. It reads as a mistake.',
      levels: 'Blurry',
    },
    {
      until: 100,
      name: 'Real contrast',
      verdict: 'Now it’s a decision. One thing leads and everything else follows.',
      levels: '3 clear levels',
    },
  ];

  document.querySelectorAll<HTMLElement>('[data-machine]').forEach((root) => {
    const amount = root.querySelector<HTMLInputElement>('[data-amount]')!;
    const zone = root.querySelector<HTMLElement>('[data-zone]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const reading = (key: string) => root.querySelector<HTMLElement>(`[data-reading="${key}"]`)!;

    const update = () => {
      const dial = Number(amount.value);
      // Eased, so the weak end of the slider moves slowly through the "almost the same" sizes
      const c = (dial / 100) ** 2;
      root.style.setProperty('--c', String(c));

      const now = ZONES.find((z) => dial <= z.until)!;
      zone.textContent = now.name;
      if (verdict.textContent !== now.verdict) verdict.textContent = now.verdict;
      root.dataset.level = String(ZONES.indexOf(now));

      reading('size').textContent = `Title is ${((1.1 + c * 3.5) / (1 - c * 0.22)).toFixed(1)}× the text`;
      reading('weight').textContent = `${Math.round(400 + c * 500)} against 400`;
      reading('value').textContent = `Text is ${Math.round(c * 45)}% paler than the title`;
      reading('space').textContent = `${(0.4 + c * 2.2).toFixed(1)} lines under the title`;
      reading('image').textContent = `Moon at ${Math.round((0.45 + c * 1.15) * 100)}%`;
      reading('levels').textContent = now.levels;
    };

    amount.addEventListener('input', update);
    update();
  });
</script>

<style>
  .machine__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 20px clamp(32px, 6vw, 96px);
    align-items: end;
  }

  .machine__rule {
    max-width: 30rem;
    color: var(--ink-soft);
  }

  .machine__stage {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 32px clamp(32px, 6vw, 96px);
    align-items: start;
    margin-top: clamp(28px, 4vw, 48px);
  }

  .bill {
    --base: 4.3cqi;
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    container-type: inline-size;
    overflow: hidden;
  }

  .bill__in {
    position: relative;
    padding: 10cqi 9cqi;
  }

  .bill__moon {
    position: absolute;
    right: 9cqi;
    bottom: 10cqi;
    width: 30cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--pen) calc(var(--c) * 100%), #9a958b);
    transform: scale(calc(0.45 + var(--c) * 1.15));
    transform-origin: 100% 100%;
  }

  .bill__title {
    font-family: var(--display);
    font-variation-settings: 'opsz' 144;
    font-weight: calc(400 + var(--c) * 500);
    font-size: calc(var(--base) * (1.1 + var(--c) * 3.5));
    line-height: calc(1.3 - var(--c) * 0.44);
    letter-spacing: calc(var(--c) * -0.04em);
  }

  .bill__date {
    margin-top: calc(var(--base) * 1.3 * (0.4 + var(--c) * 2.2));
    font-size: calc(var(--base) * (1 + var(--c) * 0.5));
    font-weight: calc(400 + var(--c) * 300);
    line-height: 1.3;
    color: color-mix(in srgb, var(--pen) calc(var(--c) * 100%), var(--ink));
  }

  .bill__line {
    margin-top: calc(var(--base) * 0.3);
    font-size: calc(var(--base) * (1 - var(--c) * 0.22));
    line-height: 1.3;
    color: color-mix(in srgb, var(--sheet) calc(var(--c) * 45%), var(--ink));
  }

  .bill__date + .bill__line {
    margin-top: calc(var(--base) * (0.3 + var(--c) * 1.2));
  }

  .machine__zone-label {
    color: var(--ink-soft);
  }

  .machine__zone {
    margin-top: 6px;
    font-family: var(--display);
    font-weight: 900;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(2rem, 4.4vw, 3.7rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  [data-level='1'] .machine__zone {
    color: var(--ink-soft);
  }

  [data-level='2'] .machine__zone {
    color: var(--pen);
  }

  .machine__verdict {
    min-height: 3.8em;
    margin-top: 14px;
    font-family: var(--display);
    font-style: italic;
    font-variation-settings: 'opsz' 36;
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    line-height: 1.2;
  }

  .machine__readings {
    margin: 18px 0 0;
    border-top: 1px solid var(--hairline);
  }

  .machine__readings div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding-block: 9px;
    border-bottom: 1px solid var(--hairline);
  }

  .machine__readings dt {
    color: var(--ink-soft);
  }

  .machine__readings dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .machine__slider {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    margin-top: clamp(24px, 3vw, 40px);
    padding-block: 18px;
    border-block: 1.5px solid var(--ink);
  }

  .machine__track {
    position: relative;
    display: flex;
  }

  .machine__mark {
    position: absolute;
    left: var(--at);
    top: 50%;
    height: 18px;
    margin-top: -9px;
    border-left: 1.5px dashed var(--pencil);
    pointer-events: none;
  }

  .machine__slider input {
    flex: 1;
    width: 100%;
    height: 34px;
    margin: 0;
    background: none;
    appearance: none;
    -webkit-appearance: none;
    cursor: grab;
  }

  .machine__slider input::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--ink);
  }

  .machine__slider input::-moz-range-track {
    height: 2px;
    background: var(--ink);
  }

  .machine__slider input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -13px;
    border: 0;
    border-radius: 50%;
    background: var(--pen);
  }

  .machine__slider input::-moz-range-thumb {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: var(--pen);
  }

  @media (max-width: 760px) {
    .machine__head,
    .machine__stage {
      grid-template-columns: minmax(0, 1fr);
    }

    .machine__slider {
      position: sticky;
      bottom: 0;
      z-index: 3;
      order: 2;
      background: var(--paper);
    }

    .machine {
      display: grid;
    }

    .machine__stage {
      display: contents;
    }

    .bill {
      margin-top: 28px;
    }

    .machine__panel {
      order: 3;
      margin-top: 8px;
    }

    .machine__verdict {
      min-height: 0;
    }
  }
</style>
