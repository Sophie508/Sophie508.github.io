---
const loop = ['See', 'Name', 'Understand', 'Play', 'Notice', 'Make'];
---

<footer class="foot">
  <div class="wrap">
    <ol class="foot__loop label" aria-label="The learning loop">
      {
        loop.map((step, i) => (
          <li>
            {step}
            {i < loop.length - 1 && <span aria-hidden="true">→</span>}
          </li>
        ))
      }
    </ol>
    <div class="foot__row">
      <p class="foot__mark">Design, Noticed.</p>
      <p class="foot__note label">
        Things I'm learning to see.<br />
        Kept by Sophie (Suliu Qin).
      </p>
      <a class="foot__back label" href="/">← Back to my research</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--section-space);
    padding-block: 28px 44px;
    border-top: 1.5px solid var(--ink);
  }

  .foot__loop {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    color: var(--ink-soft);
  }

  .foot__loop li {
    display: flex;
    gap: 14px;
  }

  .foot__loop span {
    color: var(--pen);
  }

  .foot__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
    margin-top: clamp(48px, 8vw, 96px);
  }

  .foot__mark {
    font-family: var(--display);
    font-style: italic;
    font-weight: 600;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(2rem, 5vw, 3.6rem);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-right: auto;
  }

  .foot__note {
    color: var(--ink-soft);
  }

  .foot__back {
    padding-bottom: 3px;
    border-bottom: 1.5px solid var(--ink);
  }

  .foot__back:hover {
    color: var(--pen);
    border-bottom-color: var(--pen);
  }
</style>
