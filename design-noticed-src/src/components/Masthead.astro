---
import { href, pages, sightingsPage } from '../links';

const items = [...pages, sightingsPage];
const current = Astro.url.pathname;
---

<header class="mast wrap">
  <a class="mast__mark" href={href('/')}>Design, Noticed.</a>
  <nav class="mast__nav label" aria-label="Main">
    {
      items.map((item) => (
        <a href={href(item.path)} aria-current={current.includes(item.path) ? 'page' : undefined}>
          {item.name}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .mast {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 24px;
    padding-block: 22px 18px;
  }

  .mast__mark {
    font-family: var(--display);
    font-style: italic;
    font-weight: 600;
    font-variation-settings: 'opsz' 40;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mast__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(14px, 2.2vw, 30px);
  }

  .mast__nav a {
    padding-bottom: 3px;
    border-bottom: 1.5px solid transparent;
  }

  .mast__nav a:hover,
  .mast__nav a[aria-current='page'] {
    border-bottom-color: var(--pen);
  }
</style>
