---
interface Props {
  word: string;
  gloss: string;
  idea: string;
  /** Width of the word as a share of the column, tuned per word so it fills the line */
  size: number;
}

const { word, gloss, idea, size } = Astro.props;
---

<div class="named">
  <p class="named__lead">There’s a name for what just happened.</p>
  <h2 class="named__word display" style={`--fit:${size}`}>{word}</h2>
  <div class="named__foot">
    <p class="hand">{gloss}</p>
    <p class="named__idea"><span class="marked">{idea}</span></p>
  </div>
</div>

<style>
  .named__lead {
    font-family: var(--display);
    font-style: italic;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    line-height: 1.15;
  }

  .named__word {
    margin-top: 0.12em;
    margin-left: -0.03em;
    font-size: calc(var(--fit) * 0.86vw);
    font-size: calc(var(--fit) * 1cqi);
    white-space: nowrap;
  }

  .named__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 40px;
    margin-top: clamp(20px, 3vw, 36px);
  }

  .named__foot .hand {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    transform: rotate(-2deg);
  }

  .named__idea {
    max-width: 22em;
    font-family: var(--display);
    font-weight: 600;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(1.5rem, 3.2vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
</style>
