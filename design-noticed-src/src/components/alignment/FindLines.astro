    padding: 10px 0 10px 16px;
    border-bottom: 1px solid var(--hairline);
    border-left: 2px dashed var(--pencil);
    color: var(--ink-soft);
    font-size: 0.95em;
  }

  .finder__found :global(li.is-pen) {
    border-left-color: var(--pen);
  }

  .finder__found :global(.label) {
    color: var(--ink);
  }

  .finder__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  @media (max-width: 760px) {
    .finder__head,
    .finder__stage {
      grid-template-columns: minmax(0, 1fr);
    }

    .finder__panel {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 20px;
      align-items: end;
    }

    .finder__status {
      margin-top: 0;
    }

    .finder__found,
    .finder__actions {
      grid-column: 1 / -1;
    }
  }
</style>
